# Copy this file to .streamlit/secrets.toml (never commit the real one).
# On Streamlit Community Cloud paste the same lines into App settings > Secrets.

# Ground stations from the World Air Quality Index project.
# Free token: https://aqicn.org/data-platform/token/
AQICN_API_TOKEN = "your_waqi_token"

# Optional: extra open government, research and low cost sensor networks.
# Free key: https://explore.openaq.org/register
OPENAQ_API_KEY = ""
